ryoku.dev {
	# ryolink serves everything on one loopback port: the store landing
	# page, /api/items, /files/* downloads, /d/* mirror redirects, and the
	# radio stream. Caddy's only jobs are TLS and publishing that port —
	# there is no web root and no static site to deploy anymore.
	#
	# Big ISOs stream through here; disable Caddy's request timeouts so a
	# slow resume is never cut off, and stream without buffering.
	reverse_proxy 127.0.0.1:8090 {
		flush_interval -1
	}
}
