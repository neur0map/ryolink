# ── data wipe schedule ──────────────────────────────────────────────
# The sweep that keeps the room disposable. Weekday name + HH:MM, both UTC.
# `disabled: true` makes chat permanent — then update the splash/help copy
# yourself, because it still says "resets weekly".
purge:
  disabled: false
  weekday: "sunday"
  time: "23:59"

# ── reddit feed ─────────────────────────────────────────────────────
# The feed catalog. This list is authoritative: ryolink syncs it into the
# database at startup and on `ryolink service reload`, so adding or deleting a line
# here adds or removes a sub. `ryolink --feed-add/--feed-remove` still work
# live between restarts. Needs REDDIT_CLIENT_ID/SECRET in api: above.
feed:
  subreddits:
    - "archlinux"
    - "unixporn"
    - "freebsd"
