# ─────────────────────────────────────────────────
# Ryolink Configuration — the ryoku store, and a room
# ─────────────────────────────────────────────────
# Quick start: `ryolink init` writes this file for you (into
# ~/.config/ryolink/), auto-detecting your owner fingerprint.
# The "ryolink" name is reserved — see TRADEMARK.md.
# ─────────────────────────────────────────────────

ryolink:
  name: "ryolink"             # Displayed in topbar, splash screen, window title
  domain: "ryoku.dev"         # Shown in SSH instructions and website
  tagline: ""                 # Optional — shown on splash below the name

owner:
  name: "yourname"            # Your nickname (reserved, shown with a star)
  fingerprint: "SHA256:..."   # Your SSH public key fingerprint
                              # Find it: ssh-keygen -lf ~/.ssh/id_ed25519.pub

server:
  host: "0.0.0.0"
  port: 2222                  # Production: 22 (ryolink.service grants the cap)
  data_dir: ""                # Default: the directory holding this file.
                              # Everything mutable (db, host key, logs, admin
                              # signals, staged store files) lives here.
  idle_timeout: "2h"          # Drop sessions with no input for this long
  log_file: ""                # "" = stderr (use journald in service mode)
  web_audio: false            # 24/7 radio stream endpoint (same web port)
  web_bind: "127.0.0.1"       # The web surface stays loopback; publish via Caddy
  web_port: 8090

# The abuse firewall. The server accepts ANY SSH key — the key IS the identity —
# so what a real sshd would police is handled here, in-process:
#   - concurrent connection budget (global and per-IP)
#   - per-IP new-connection rate limit
#   - ban after N failed handshakes/min (temporary, persisted across restarts)
#   - ban for port-scanner probes (short keyless connections, no handshake)
security:
  max_conns: 512              # Total in-flight TCP connections
  max_conns_per_ip: 4         # One household, four tabs is generous
  new_conns_per_min: 30       # Per-IP connection rate
  max_auth_fails: 10          # Failed handshakes per minute before a ban
  ban_minutes: 30             # Auth-failure network ban length
  probe_ban_minutes: 60       # Scanner-probe ban length
  deny_cidrs: []              # Always blocked, e.g. ["203.0.113.0/24"]
  allow_cidrs: []             # When non-empty, ONLY these ranges connect

# Input mode. ryolink is cursor-first: clicks activate rooms and items,
# keyboard shortcuts keep working beside them. ctrl+m toggles live.
bind:
  mouse: "auto"               # auto|on = clicks active, off = keyboard only

# ── The store ────────────────────────────────────
# ryolink's front page: the Ryoku ISO, the panic-button recovery script,
# rescue files. The TUI #store room browses this; the web landing page
# (same port as web_audio) serves it. Items with a local `path` stream
# from this box (Range-safe, resumable); items with a `url` redirect to
# your mirror — keep multi-gigabyte ISOs on a CDN, not on the chat box.
#
# Stage files into the data dir (e.g. data/store/ryoku.iso) and they appear
# with size + sha256 automatically. No restart needed: the catalog re-checks
# disk when the storefront is opened.
store:
  enabled: true
  title: "Ryoku Store"
  public_url: ""              # e.g. https://dl.ryoku.dev — default: this host
  items:
    # A one-word `logo:` renders as a block-letter wordmark on the card.
    # Multi-line values are shown verbatim as ASCII art, if you prefer.
    # `details:` is the long form — it shows only in the product card
    # (ENTER on a card), where the text wraps and scrolls. Keep `desc:` to
    # one line: it's the most the bento grid has room for.
    - id: "ryoku-iso"
      name: "Ryoku Linux"
      kind: iso
      version: "0.59"
      desc: "The live image. Arch underneath, Hyprland + Quickshell on top."
      details: |
        The Ryoku desktop in one ISO: Arch underneath, Hyprland and the
        Quickshell shell on top, with the Ryostore, the Hub control center,
        and ryogami wallpaper daemon already wired.

        Boot it live from a USB stick to look around, or run the installer
        straight from the session. Everything the desktop touches lives in
        ~/.config — take it with you.

        Verify the download: the storefront card shows the sha256 once the
        operator has staged the file, and `x` copies it.
      url: "https://github.com/ryoku-dev/ryoku-arch/releases/latest"   # mirror
      logo: "ARCH"
    - id: "ryoku-cachyos-iso"
      name: "Ryoku CachyOS"
      kind: iso
      version: "0.59"
      desc: "Same desktop, CachyOS base: x86-64-v3 tuning + BORE scheduler."
      url: "https://github.com/ryoku-dev/ryoku-arch/releases/latest"
      logo: "CACHY"
    - id: "recovery"
      name: "ryoku-recovery"
      kind: script
      desc: "The panic button: rebuilds the desktop from origin when an update bites."
      path: "store/ryoku-recovery.sh"
      logo: "RYOKU"
    - id: "shell-installer"
      name: "ryoku-shell-install"
      kind: script
      desc: "Convert an existing Arch box to the Ryoku desktop, one script."
      path: "store/ryoku-shell-install.sh"
      logo: "RYOKU"

# Optional API keys. Environment variables (same names as the comments) win,
# so secrets can live in EnvironmentFile= instead of here.
api:
  openai_key: ""              # bartender (OPENAI_API_KEY)
  klipy_key: ""               # /gif search (KLIPY_API_KEY)
  exa_key: ""                 # bartender web search (EXA_API_KEY)
  reddit_client_id: ""        # reddit feed OAuth (REDDIT_CLIENT_ID)
  reddit_secret: ""           # (REDDIT_CLIENT_SECRET)

rooms:
  # First room = landing = the store front. Chat rooms are secondary.
  - name: "store"
    type: store               # the ryoku storefront (requires store.enabled)
  - name: "lounge"
    type: chat                # the bar — Mika works the lounge
  - name: "gallery"
    type: gallery             # sticky-note canvas
  - name: "games"
    type: games               # sudoku and other games
  - name: "suggestions"
    type: chat


  # Wargame CTF rooms. The bandit board below is stocked with real
  # OverTheWire level passwords — see the wargame: block.
  - name: "bandit"
    type: wargame
  # - name: "natas"
  #   type: wargame

# ── wargame CTF boards ──────────────────────────────────────────────
# The flag table lives here: add a level, fix a leaked flag, or remove a
# level (set its flag to "") by editing this file. ryolink syncs it into the
# database at startup and on `ryolink service reload`. A game listed here needs a
# matching room of type wargame above.
#
# The values below are OverTheWire bandit's real level passwords — they let
# players hop between levels on bandit.labs.overthewire.org, which is public
# information. Swap in your own flags for a private board any time.
